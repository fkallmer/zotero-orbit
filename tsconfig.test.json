{
  "//": "The project for the tests Node runs. It once held only Zotero-independent modules, and said so; the pane and graph render tests import citationPane and graphTab, which pulls Zotero's own globals in whether the config names them or not. So it takes the same resolution and types as the main project -- bundler resolution for src's extensionless imports, and zotero-types for Document, HTMLElement and Zotero -- and keeps only what is genuinely test-specific: Node's types, and .ts extensions in the tests' own imports.",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    // Not nodenext: src/ is written for esbuild and imports `../utils/locale`
    // without an extension, which nodenext rejects outright (TS2835). Node's own
    // resolution at runtime is bridged by test/register.mjs, not by this.
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node", "zotero-types/entries/sandbox"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "test/**/*.ts",
    // `addon` and `ztoolkit` are declared here, and the modules the render
    // tests import use both.
    "typings",
    "src/modules/citationTypes.ts",
    "src/modules/ignorePolicy.ts",
    "src/modules/preferenceMessages.ts",
    "src/modules/semanticScholarKeyState.ts",
    "src/modules/fwciUpdate.core.ts",
    "src/modules/semanticScholarClient.core.ts",
    "src/utils/abort.ts",
    "src/utils/contact.ts",
    "src/utils/errors.ts",
    "src/utils/fwciStore.ts",
    "src/utils/httpOutcome.ts",
    "src/utils/identifiers.ts",
    "src/utils/ignoreStore.ts",
    "src/utils/pacing.ts",
    "src/utils/retryAge.ts",
    "src/utils/temporalParse.ts",
    "src/utils/s2Identifiers.ts"
  ],
  "exclude": ["test/zotero"]
}
