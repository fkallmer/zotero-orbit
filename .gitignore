#########
### specialized ignore patterns ###
#########
**/*-ignore/
**/*-ignore-*
**/*-ignore_*
**/*-ignore.*
**/*_ignore/
**/*_ignore-*
**/*_ignore_*
**/*_ignore.*
**/*-gitignore*
**/*_gitignore*

#########
### generated directories ###
#########
node_modules

### Deny the directory's contents, then re-admit what is genuinely source.
### Must be `.yarn/*`, never `.yarn/` -- git cannot re-include a path whose
### parent directory is excluded.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

#########
### generated files ###
#########
!yarn.lock ### needed for cl workflow git hook
tsconfig.tsbuildinfo

#########
### important ###
#########
.env

#########
### project specific patterns ###
#########

# Scaffold
.env
.env.example
.scaffold
build
logs

#########
### macOS ###
#########
.DS_Store

# Yarn's local link cache. It records absolute paths, so it changes on every
# install and whenever the checkout moves -- machine state, not source.
.yarn/install-state.gz

# The contact address sent to OpenAlex for its polite pool. Kept out of the
# repository on purpose: it identifies whoever runs this build, and a fork
# published from here must not carry someone else's address.
.orbit-contact
